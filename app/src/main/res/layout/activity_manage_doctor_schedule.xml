<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.admin.ManageDoctorScheduleActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:menu="@menu/menu_admin_schedules"
        app:navigationContentDescription="@string/navigate_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/schedule_title"
        app:titleTextColor="@color/medibook_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/sessionLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                style="@style/Widget.MediBook.Progress.Session"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:indicatorSize="24dp" app:trackThickness="3dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="start|center_vertical"
                android:text="@string/checking_session"
                android:textAppearance="@style/TextAppearance.MediBook.Body" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/adminPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/appointment_publish_intro" android:textAppearance="@style/TextAppearance.MediBook.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/publicationDateButton"
                    style="@style/Widget.MediBook.PickerButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/appointment_date" app:icon="@drawable/ic_calendar_cross" />
                <com.google.android.material.button.MaterialButton android:id="@+id/publishSlotsButton"
                    style="@style/Widget.MediBook.PrimaryButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/appointment_publish_slots" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/publicationProgress"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:indeterminate="true" android:visibility="gone" />
                <TextView android:id="@+id/publicationStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:saveEnabled="false"
                    android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.MediBook.Body" />
            </LinearLayout>
            <!-- Existing schedule management remains below the always-visible publication controls. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/adminContent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:clipToPadding="false"
                android:padding="16dp" android:scrollbars="vertical" tools:listitem="@layout/item_doctor_schedule" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
