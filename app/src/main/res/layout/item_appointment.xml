<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.MediBook.AuthCard"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md"
    android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_content">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MediBook.CardTitle" android:saveEnabled="false" />
        <com.google.android.material.chip.Chip android:id="@+id/status" style="@style/Widget.MediBook.Status"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:saveEnabled="false" />
        <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.MediBook.Body" android:saveEnabled="false" />
        <TextView android:id="@+id/slot" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:textAppearance="@style/TextAppearance.MediBook.CardTitle"
            android:textColor="@color/medibook_blue" android:saveEnabled="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
