<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" tools:context=".activities.patient.DoctorProfileActivity">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/white" app:title="@string/patient_profile_title"
        app:titleTextColor="@color/medibook_text" app:menu="@menu/menu_patient"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/navigate_back" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include android:id="@+id/sessionLoading" layout="@layout/view_patient_session_loading" />
        <androidx.core.widget.NestedScrollView
            android:id="@+id/patientContent" android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:clipToPadding="false" android:visibility="gone" tools:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/errorContent" style="@style/Widget.MediBook.AuthCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="24dp">
                        <TextView android:id="@+id/errorHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/patient_profile_error_title" android:textAppearance="@style/TextAppearance.MediBook.Heading" />
                        <TextView android:id="@+id/errorMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                            android:text="@string/patient_profile_error_message" android:textAppearance="@style/TextAppearance.MediBook.Body" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/retryButton"
                            style="@style/Widget.MediBook.TextButton" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/patient_directory_retry" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout android:id="@+id/profileContent" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MediBook.AuthCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/medibook_teal_container">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="24dp">
                            <ImageView android:id="@+id/doctorImage" android:layout_width="88dp" android:layout_height="88dp" android:src="@drawable/avatar_doctor"
                                android:importantForAccessibility="no" />
                            <TextView android:id="@+id/profileStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="16dp" android:text="@string/doctor_active_status"
                                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:textColor="@color/medibook_teal_dark" />
                            <TextView android:id="@+id/doctorName" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="@style/TextAppearance.MediBook.Heading" />
                            <TextView android:id="@+id/specialization" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/medibook_teal_dark" />
                            <TextView android:id="@+id/profileNotice" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="16dp" android:visibility="gone"
                                android:textAppearance="@style/TextAppearance.MediBook.Body" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MediBook.AuthCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="24dp">
                            <TextView android:id="@+id/qualificationsHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/doctor_qualifications_label" android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                android:textColor="@color/medibook_text" />
                            <TextView android:id="@+id/qualifications" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="@style/TextAppearance.MediBook.Body" />
                            <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xl" android:layout_marginBottom="@dimen/space_xl" />
                            <TextView android:id="@+id/consultationFee" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textColor="@color/medibook_teal_dark" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MediBook.AuthCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="24dp">
                            <TextView android:id="@+id/aboutHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/patient_profile_about_heading" android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="@color/medibook_text" />
                            <TextView android:id="@+id/biography" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textAppearance="@style/TextAppearance.MediBook.Body" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.MediBook.AuthCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="24dp">
                            <ImageView android:layout_width="32dp" android:layout_height="32dp"
                                android:src="@drawable/ic_schedule_clock" android:importantForAccessibility="no" />
                            <TextView android:id="@+id/scheduleHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="12dp" android:text="@string/patient_profile_schedule_heading"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/medibook_text" />
                            <TextView android:id="@+id/scheduleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                                android:text="@string/patient_live_schedule_loading" android:textAppearance="@style/TextAppearance.MediBook.Body" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/scheduleRetryButton"
                                style="@style/Widget.MediBook.TextButton" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:text="@string/patient_directory_retry" android:visibility="gone" />
                            <TextView android:id="@+id/timezoneHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.MediBook.Body" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bookAppointmentButton" style="@style/Widget.MediBook.PrimaryButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/patient_profile_book_placeholder" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
