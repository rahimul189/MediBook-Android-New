<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="@dimen/form_gutter" android:paddingEnd="@dimen/form_gutter">
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout" style="@style/Widget.MediBook.Input"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/password_label" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"
            android:imeOptions="actionDone" android:maxLines="1" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
