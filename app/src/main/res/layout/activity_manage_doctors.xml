<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.admin.ManageDoctorsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:menu="@menu/menu_admin_doctors"
        app:navigationContentDescription="@string/navigate_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/manage_doctors_title"
        app:titleTextColor="@color/medibook_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/sessionLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                style="@style/Widget.MediBook.Progress.Session"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:indicatorSize="24dp" app:trackThickness="3dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="start|center_vertical"
                android:text="@string/checking_session"
                android:textAppearance="@style/TextAppearance.MediBook.Body" />
        </LinearLayout>

        <!-- The header and placeholders are adapter rows, so the entire page scrolls. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/adminContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:visibility="gone"
            tools:listitem="@layout/item_doctor"
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
