<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MediBook.AuthCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_content">

        <TextView
            android:id="@+id/doctorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MediBook.CardTitle"
            android:textColor="@color/medibook_text" />

        <TextView
            android:id="@+id/doctorSpecialization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.MediBook.Body" />

        <TextView
            android:id="@+id/consultationFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.MediBook.CardTitle"
            android:textColor="@color/medibook_teal_dark" />

        <com.google.android.material.chip.Chip
            android:id="@+id/activeStatus"
            style="@style/Widget.MediBook.Status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checkable="false"
            android:clickable="false"
            android:focusable="false"
            app:chipStrokeWidth="0dp"
            app:ensureMinTouchTargetSize="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editButton"
            style="@style/Widget.MediBook.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edit_doctor_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scheduleButton"
            style="@style/Widget.MediBook.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_manage_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/statusButton"
            style="@style/Widget.MediBook.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            app:cornerRadius="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
