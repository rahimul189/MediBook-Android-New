<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.admin.AddEditDoctorActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:menu="@menu/menu_admin_doctors"
        app:navigationContentDescription="@string/navigate_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/add_doctor_button"
        app:titleTextColor="@color/medibook_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/sessionLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                style="@style/Widget.MediBook.Progress.Session"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:indicatorSize="24dp" app:trackThickness="3dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="start|center_vertical"
                android:text="@string/checking_session"
                android:textAppearance="@style/TextAppearance.MediBook.Body" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/adminContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.MediBook.AuthCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/doctor_form_guidance"
                            android:textAppearance="@style/TextAppearance.MediBook.Body" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/operationProgress"
                            style="@style/Widget.MediBook.Progress.Action"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:indeterminate="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/operationStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.MediBook.Body"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/retryButton"
                            style="@style/Widget.MediBook.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/doctor_reload_button"
                            android:visibility="gone" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/nameLayout"
                            style="@style/Widget.MediBook.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/doctor_name_label"
                            app:counterEnabled="true"
                            app:counterMaxLength="100">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/nameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:imeOptions="actionNext"
                                android:inputType="textPersonName|textCapWords"
                                android:maxLength="100"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/specializationLayout"
                            style="@style/Widget.MediBook.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/doctor_specialization_label"
                            app:counterEnabled="true"
                            app:counterMaxLength="100">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/specializationInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:imeOptions="actionNext"
                                android:inputType="text|textCapWords"
                                android:maxLength="100"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/qualificationsLayout"
                            style="@style/Widget.MediBook.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/doctor_qualifications_label"
                            app:counterEnabled="true"
                            app:counterMaxLength="200">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/qualificationsInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:imeOptions="actionNext"
                                android:inputType="text|textCapWords"
                                android:maxLength="200"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/feeLayout"
                            style="@style/Widget.MediBook.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/doctor_fee_label"
                            app:helperText="@string/doctor_fee_guidance">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/feeInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:maxLength="12"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/biographyLayout"
                            style="@style/Widget.MediBook.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/doctor_biography_label"
                            app:counterEnabled="true"
                            app:counterMaxLength="1000">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/biographyInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:importantForAutofill="no"
                                android:inputType="text|textMultiLine|textCapSentences"
                                android:maxLength="1000"
                                android:minLines="4" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/imageUrlLayout" style="@style/Widget.MediBook.Input"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="@string/doctor_image_url_label" app:helperText="@string/doctor_image_url_help">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/imageUrlInput" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:inputType="textUri"
                                android:importantForAutofill="no" android:maxLength="2048" android:maxLines="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/activeSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            android:text="@string/doctor_active_label" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/doctor_active_guidance"
                            android:textAppearance="@style/TextAppearance.MediBook.Body" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/saveButton"
                            style="@style/Widget.MediBook.PrimaryButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/save_button" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cancelButton"
                            style="@style/Widget.MediBook.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cancel_button" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
